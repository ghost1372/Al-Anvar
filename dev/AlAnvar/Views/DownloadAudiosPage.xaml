<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="AlAnvar.Views.DownloadAudiosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:AlAnvar.Views"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:tv="using:WinUI.TableView"
      NavigationCacheMode="Required"
      mc:Ignorable="d">

    <Grid x:Uid="Main_FlowDirection" RowSpacing="10">
        <tv:TableView x:Name="AudiosTableView" AutoGenerateColumns="False" CanFilterColumns="False" CanSortColumns="True" CornerButtonMode="None" CornerRadius="8,8,0,0" GridLinesVisibility="Horizontal" HeaderGridLinesVisibility="Horizontal" IsReadOnly="True" ItemsSource="{x:Bind ViewModel.AudioItems, Mode=OneWay}" SelectionMode="Single" SelectionUnit="Row">
            <tv:TableView.Columns>
                <tv:TableViewTextColumn x:Uid="DownloadAudiosPage_TableViewPName" Width="250" Binding="{Binding PersianName}" />
                <tv:TableViewTextColumn x:Uid="DownloadAudiosPage_TableViewName" Width="250" Binding="{Binding Name}" />
                <tv:TableViewCheckBoxColumn x:Uid="DownloadAudiosPage_TableViewActive" Binding="{Binding IsActive}" />
                <tv:TableViewTemplateColumn Width="150">
                    <tv:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Uid="DownloadAudiosPage_Download" HorizontalAlignment="Stretch" Click="OnDownloadAudio" Style="{ThemeResource SubtleButtonStyle}" />
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.CellTemplate>
                </tv:TableViewTemplateColumn>
            </tv:TableView.Columns>
        </tv:TableView>

        <ProgressRing HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="{x:Bind ViewModel.IsActive, Mode=OneWay}" />

    </Grid>
</Page>
