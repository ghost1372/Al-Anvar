<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="AlAnvar.Views.AudioSettingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:common="using:AlAnvar.Common"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:AlAnvar.Views"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      x:Uid="Main_FlowDirection"
      dev:BreadcrumbNavigator.IsHeaderVisible="True"
      mc:Ignorable="d">

    <ScrollView>
        <StackPanel Margin="10" ChildrenTransitions="{StaticResource SettingsCardsAnimations}" Spacing="5">
            <dev:SettingsCard x:Uid="AudioSettingPage_AudioChoose" HeaderIcon="{dev:BitmapIcon Source=Assets/Fluent/Audio.png}">
                <ComboBox x:Name="cmbAudio" MinWidth="250" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ItemsSource="{x:Bind ViewModel.ExistingAudioItems, Mode=OneWay}" SelectedIndex="{x:Bind common:AppHelper.Settings.AudioIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedItem="{x:Bind common:AppHelper.Settings.Audio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </dev:SettingsCard>
            <dev:SettingsExpander x:Uid="AudioSettingPage_AudioSaveLocation" HeaderIcon="{dev:BitmapIcon Source=Assets/Fluent/Folder.png}">
                <Button x:Uid="AudioSettingPage_ChooseFolder" MinWidth="220" Command="{x:Bind ViewModel.ChooseFolderCommand}" />
                <dev:SettingsExpander.ItemsHeader>
                    <HyperlinkButton HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{x:Bind ViewModel.GoToFolderInExplorerCommand}" Content="{x:Bind ViewModel.AudiosPath, Mode=OneWay}" FlowDirection="LeftToRight" />
                </dev:SettingsExpander.ItemsHeader>
            </dev:SettingsExpander>
            <dev:SettingsCard x:Uid="AudioSettingPage_DownloadAudio" HeaderIcon="{dev:BitmapIcon Source=Assets/Fluent/Download.png}">
                <HyperlinkButton x:Uid="AudioSettingPage_ViewMoreAudio" Command="{x:Bind ViewModel.GoToDownloadAudioPageCommand}" />
            </dev:SettingsCard>
        </StackPanel>
    </ScrollView>
</Page>
