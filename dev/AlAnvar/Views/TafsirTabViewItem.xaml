<?xml version="1.0" encoding="utf-8" ?>
<TabViewItem x:Class="AlAnvar.Views.TafsirTabViewItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="using:AlAnvar.Common"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:AlAnvar.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="1"
                      Padding="10">
            <RichTextBlock x:Name="TafsirRichTextBlock"
                           common:RichTextBlockExtensions.HighlightingText="{x:Bind ViewModel.Query, Mode=OneWay}"
                           common:RichTextBlockExtensions.Text="{x:Bind paragraph, Mode=OneWay}"
                           IsHitTestVisible="False"
                           TextAlignment="Justify" />
        </ScrollViewer>

        <ProgressRing Grid.RowSpan="2"
                      IsActive="{x:Bind ViewModel.IsActive, Mode=OneWay}" />
    </Grid>
</TabViewItem>
