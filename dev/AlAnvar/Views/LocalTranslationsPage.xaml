<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="AlAnvar.Views.LocalTranslationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:AlAnvar.Views"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:tv="using:WinUI.TableView"
      NavigationCacheMode="Required"
      mc:Ignorable="d">

    <Grid x:Uid="Main_ReverseFlowDirection" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Border Margin="5"
                Padding="10"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource CommandBarBackgroundOpen}"
                BorderBrush="{ThemeResource CommandBarBorderBrushOpen}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                <Button x:Name="BtnDeleteSelection"
                        Click="OnDeleteSelection"
                        IsEnabled="False"
                        Style="{ThemeResource SubtleButtonStyle}">
                    <StackPanel x:Uid="Main_FlowDirection" Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE74D;" />
                        <TextBlock x:Uid="LocalTranslationsPage_DeleteSelection" />
                    </StackPanel>
                </Button>
                <Button x:Name="BtnOpenFolder"
                        Click="OnOpenFolder"
                        IsEnabled="False"
                        Style="{ThemeResource SubtleButtonStyle}">
                    <StackPanel x:Uid="Main_FlowDirection" Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xEC50;" />
                        <TextBlock x:Uid="LocalTranslationsPage_OpenFolder" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
        <tv:TableView x:Name="TranslationsTableView"
                      x:Uid="Main_FlowDirection"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      CanFilterColumns="False"
                      CanSortColumns="True"
                      CornerButtonMode="None"
                      CornerRadius="8,8,0,0"
                      GridLinesVisibility="Horizontal"
                      HeaderGridLinesVisibility="Horizontal"
                      IsReadOnly="True"
                      ItemsSource="{x:Bind ViewModel.LocalTranslationItems, Mode=OneWay}"
                      SelectionChanged="TranslationsTableView_SelectionChanged"
                      SelectionMode="Extended"
                      SelectionUnit="Row">
            <tv:TableView.Columns>
                <tv:TableViewTextColumn x:Uid="LocalTranslationsPage_TableViewLanguage"
                                        Width="100"
                                        Binding="{Binding Language}" />
                <tv:TableViewTextColumn x:Uid="LocalTranslationsPage_TableViewTranslator"
                                        Width="300"
                                        Binding="{Binding Translator}" />
                <tv:TableViewTextColumn x:Uid="LocalTranslationsPage_TableViewName"
                                        Binding="{Binding Name}" />
            </tv:TableView.Columns>
        </tv:TableView>

        <ProgressRing Grid.Row="1"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsActive="{x:Bind ViewModel.IsActive, Mode=OneWay}" />

        <TeachingTip x:Uid="TranslationNotFoundNotificationText"
                     IsLightDismissEnabled="True"
                     IsOpen="{x:Bind ViewModel.ShowTranslationNotFound, Mode=TwoWay}"
                     Target="{x:Bind TranslationsTableView}" />
    </Grid>
</Page>
