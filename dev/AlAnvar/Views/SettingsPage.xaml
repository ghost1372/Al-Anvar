<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="AlAnvar.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:AlAnvar"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:views="using:AlAnvar.Views"
      x:Uid="Main_FlowDirection"
      dev:BreadcrumbNavigator.IsHeaderVisible="True"
      mc:Ignorable="d">
    <ScrollView Margin="{ThemeResource ContentPageMargin}" Padding="{ThemeResource ContentPagePadding}" HorizontalAlignment="Stretch" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10" dev:PanelAttach.ChildrenTransitions="Default" Spacing="5">
            <dev:SettingsCard x:Name="GeneralCard" x:Uid="SettingsPage_General" Command="{x:Bind local:App.Current.NavService.NavigateToCommand}" CommandParameter="{x:Bind GeneralParam, Mode=OneWay}" HeaderIcon="{dev:BitmapIcon Source=Assets/Fluent/General.png}" IsClickEnabled="True" />
            <dev:SettingsCard x:Name="DatabaseCard" x:Uid="SettingsPage_Database" Command="{x:Bind local:App.Current.NavService.NavigateToCommand}" CommandParameter="{x:Bind DatabaseParam, Mode=OneWay}" HeaderIcon="{dev:BitmapIcon Source=Assets/Fluent/Database.png}" IsClickEnabled="True" />
            <dev:SettingsCard x:Name="TranslationCard" x:Uid="SettingsPage_Translations" Command="{x:Bind local:App.Current.NavService.NavigateToCommand}" CommandParameter="{x:Bind TranslationsParam, Mode=OneWay}" HeaderIcon="{dev:BitmapIcon Source=Assets/Fluent/Translation.png}" IsClickEnabled="True" />
            <dev:SettingsCard x:Name="AudioCard" x:Uid="SettingsPage_Audios" Command="{x:Bind local:App.Current.NavService.NavigateToCommand}" CommandParameter="{x:Bind AudiosParam, Mode=OneWay}" Description="Change Quran Audios" Header="Audios" HeaderIcon="{dev:BitmapIcon Source=Assets/Fluent/Audio.png}" IsClickEnabled="True" />
            <dev:SettingsCard x:Name="ThemeCard" x:Uid="SettingsPage_Theme" Command="{x:Bind local:App.Current.NavService.NavigateToCommand}" CommandParameter="{x:Bind ThemeParam, Mode=OneWay}" HeaderIcon="{dev:BitmapIcon Source=Assets/Fluent/Theme.png}" IsClickEnabled="True" />
            <dev:SettingsCard x:Name="UpdateCard" x:Uid="SettingsPage_Update" Command="{x:Bind local:App.Current.NavService.NavigateToCommand}" CommandParameter="{x:Bind UpdateParam, Mode=OneWay}" HeaderIcon="{dev:BitmapIcon Source=Assets/Fluent/Update.png}" IsClickEnabled="True" />
            <dev:SettingsCard x:Name="AboutCard" x:Uid="SettingsPage_About" Command="{x:Bind local:App.Current.NavService.NavigateToCommand}" CommandParameter="{x:Bind AboutParam, Mode=OneWay}" HeaderIcon="{dev:BitmapIcon Source=Assets/Fluent/Info.png}" IsClickEnabled="True" />
        </StackPanel>
    </ScrollView>
</Page>

