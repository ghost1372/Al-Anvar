<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <x:String x:Key="HeaderCover">ms-appx:///Assets/Cover/CoverLight.png</x:String>
            <LinearGradientBrush x:Key="HomeLandingTitleBackgroundGradient" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0.1" Color="#303030" />
                <GradientStop Offset="0.3" Color="#4A4A4A" />
                <GradientStop Offset="0.6" Color="#161515" />
                <GradientStop Offset="0.9" Color="#303030" />
            </LinearGradientBrush>
            <StaticResource x:Key="MediaPlayerPanelBackground" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
            <StaticResource x:Key="MediaPlayerBorderBrush" ResourceKey="SurfaceStrokeColorFlyoutBrush" />

        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <x:String x:Key="HeaderCover">ms-appx:///Assets/Cover/CoverDark.png</x:String>
            <LinearGradientBrush x:Key="HomeLandingTitleBackgroundGradient" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0.1" Color="#E0E0E0" />
                <GradientStop Offset="0.3" Color="#C0C0C0" />
                <GradientStop Offset="0.6" Color="#F5F5F5" />
                <GradientStop Offset="0.9" Color="#D0D0D0" />
            </LinearGradientBrush>

            <StaticResource x:Key="MediaPlayerPanelBackground" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
            <StaticResource x:Key="MediaPlayerBorderBrush" ResourceKey="SurfaceStrokeColorFlyoutBrush" />

        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <x:String x:Key="HeaderCover">ms-appx:///Assets/Cover/CoverDark.png</x:String>
            <LinearGradientBrush x:Key="HomeLandingTitleBackgroundGradient" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0.1" Color="#E0E0E0" />
                <GradientStop Offset="0.3" Color="#C0C0C0" />
                <GradientStop Offset="0.6" Color="#F5F5F5" />
                <GradientStop Offset="0.9" Color="#D0D0D0" />
            </LinearGradientBrush>
            <StaticResource x:Key="MediaPlayerPanelBackground" ResourceKey="SystemControlPageBackgroundAltMediumBrush" />
            <StaticResource x:Key="MediaPlayerBorderBrush" ResourceKey="SurfaceStrokeColorFlyoutBrush" />

        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
